# Скопируй этот файл в .env и подставь свои значения.
# .env в git не попадает. После правки перезапусти start.bat.

# Порт окна программы
SFM_PORT=8765

# Папка с ArchiSteamFarm.exe. Пусто — программа поищет сама.
ASF_DIR=

# Папка maFiles из Nebula (коды Steam Guard)
MAFILES_DIR=

# Токен бота от @BotFather. Пусто — бот просто не запустится.
TELEGRAM_BOT_TOKEN=

# Telegram id владельца (число). Узнать можно у @userinfobot.
# Если заполнено, этот человек сразу считается владельцем, без ссылки-приглашения.
TELEGRAM_OWNER_ID=

# Имя владельца в меню бота
TELEGRAM_OWNER_NAME=
