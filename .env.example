# Можно не заполнять вручную: при первом запуске программа спросит эти поля в окне.
# .env в git не попадает. После правки файла перезапусти start.bat.

# Порт окна программы
SFM_PORT=8765

# Папка с ArchiSteamFarm.exe. Пусто — программа поищет сама.
ASF_DIR=

# Папка maFiles из Nebula (коды Steam Guard)
MAFILES_DIR=

# Токен бота от @BotFather. Пусто — бот просто не запустится.
TELEGRAM_BOT_TOKEN=

# Telegram id владельца (число). Узнать можно у @userinfobot.
# Если заполнено, этот человек сразу считается владельцем, без ссылки-приглашения.
TELEGRAM_OWNER_ID=

# Имя владельца в меню бота
TELEGRAM_OWNER_NAME=

# HTTPS-адрес Mini App, например https://example.com/miniapp/
# Пусто или без https — кнопка «Открыть панель» в боте не появится. Туннель сюда не прописывается.
MINIAPP_URL=
